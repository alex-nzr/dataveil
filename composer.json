{
    "name": "flah/dataveil",
    "description": "Bitrix database anonymization CLI tool",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrei Nikolaev",
            "email": "gromdron@yandex.ru"
        }
    ],
    "require": {
        "php": "^8.0",
        "symfony/console": "^5.4",
        "symfony/yaml": "^5.4",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "DataVeil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DataVeil\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=8",
        "build:phar": "box compile"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.0.0"
        }
    }
}
